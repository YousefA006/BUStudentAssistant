# Paste your API key here. The provider is detected from the key automatically:
#   gsk_...  -> Groq      AIza... -> Gemini      sk-ant-... -> Claude
API_KEY=your-key-here
# Optional: force a provider (groq, gemini, anthropic, openai). Leave empty for automatic.
PROVIDER=

# Optional: override the default models (leave empty to use the defaults)
#   gemini -> gemini-flash-latest        groq -> openai/gpt-oss-120b (answers), openai/gpt-oss-20b (search terms)
ANSWER_MODEL=
QUERY_MODEL=

# Shared university documents go in this folder
DATA_DIR=data
# How many passages are sent to the model per question
TOP_K=6
MAX_UPLOAD_MB=25
# Use HOST=0.0.0.0 to let other devices on your network open the site
HOST=127.0.0.1
PORT=5000
